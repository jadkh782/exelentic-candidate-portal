<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Candidate Master List :: CENIS Portal</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    body { font-family: 'Times New Roman', serif; background: #e8e0d4; margin: 0; font-size: 13px; }
    .dl-btn { background:#5c7a1a; color:#fff; border:1px solid #000; padding:2px 8px; font-family:Verdana; font-size:10px; cursor:pointer; text-decoration:none; display:inline-block; }
    .dl-btn:hover { background:#7a9a2a; }
    .vw-lnk { color:#1a3a5c; font-family:Verdana; font-size:10px; text-decoration:underline; cursor:pointer; }
  </style>
</head>
<body>
  <%- include('partials/topbar', { subtitle: 'Candidate Master List', active: 'candidates' }) %>

  <!-- Fake breadcrumb that lies about location -->
  <div id="<%= chaosId() %>" class="<%= chaosClass() %>" style="background:#d4ccc0;padding:4px 20px;border-bottom:1px solid #999;" <%= chaosDataAttrs() %>>
    <font face="Verdana" size="1" color="#555">
      Home &gt; Administration &gt; Reports &gt; <b>Archived Users</b>
    </font>
  </div>

  <div style="padding:20px;">
    <div id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
      <table width="100%" border="0" cellpadding="0" cellspacing="0"><tr>
        <td><font face="Verdana" size="3" color="#333"><b>Candidate Records (<%= candidates.length %>)</b></font></td>
        <td align="right">
          <!-- search: filters the list via ?q= -->
          <form action="/dashboard" method="get" style="display:inline;margin:0" id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
            <%- ghostElement('input') %>
            <%- wrapChaos(`<input type="text" name="q" value="${(typeof query!=='undefined'?query:'').replace(/"/g,'&quot;')}" placeholder="search name / id / city..." id="${chaosId()}" class="${chaosClass()}" ${chaosDataAttrs()} style="width:180px;padding:3px;border:1px solid #aaa;font-family:Verdana;font-size:11px" autocomplete="off">`, 1, 3) %>
            <input type="submit" value="Find" id="<%= chaosId() %>" class="<%= chaosClass() %>" style="padding:3px 10px;font-family:Verdana;font-size:11px;cursor:pointer">
            <% if (typeof query !== 'undefined' && query) { %><a href="/dashboard" style="font-family:Verdana;font-size:10px;color:#888">clear</a><% } %>
          </form>
        </td>
      </tr></table>
      <br>
    </div>

    <%- legacyCruft() %>

    <!-- DECOY TABLE: hidden, looks identical in structure -->
    <div style="position:absolute;left:-9999px;opacity:0;">
      <table id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
        <tr><th>Name</th><th>ID</th><th>Position</th><th>Status</th><th>CV</th></tr>
        <% candidates.slice(0,5).forEach(function(c) { %>
          <tr id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
            <td><%= c.name %></td><td><%= c.id %></td><td><%= c.position_applied %></td><td><%= c.status %></td>
            <td><a href="#" class="dl-btn" tabindex="-1">Download CV</a></td>
          </tr>
        <% }); %>
      </table>
    </div>

    <!-- REAL TABLE: wrapped in layers, each row structured differently -->
    <div id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
      <div id="<%= chaosId() %>" class="<%= chaosClass() %>">
        <span id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
          <div id="<%= chaosId() %>" class="<%= chaosClass() %>">
            <table width="100%" border="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff" style="border-collapse:collapse;border:1px solid #999;" id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
              <thead id="<%= chaosId() %>" class="<%= chaosClass() %>">
                <tr bgcolor="#c0b8ac" id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
                  <td><font face="Verdana" size="1"><b>Candidate Name</b></font></td>
                  <td><font face="Verdana" size="1"><b>Unique ID</b></font></td>
                  <td><font face="Verdana" size="1"><b>Position Applied</b></font></td>
                  <td><font face="Verdana" size="1"><b>City</b></font></td>
                  <td><font face="Verdana" size="1"><b>Status</b></font></td>
                  <td><font face="Verdana" size="1"><b>Actions</b></font></td>
                </tr>
              </thead>
              <tbody id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
                <% candidates.forEach(function(c, idx) { %>
                  <% if (idx % 3 === 0) { %><%- ghostElement('row') %><% } %>
                  <tr id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %> bgcolor="<%= idx % 2 === 0 ? '#ffffff' : '#f0ece4' %>">

                    <!-- NAME CELL: structure varies by row index -->
                    <td id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
                      <% if (idx % 4 === 0) { %>
                        <div id="<%= chaosId() %>" class="<%= chaosClass() %>"><span id="<%= chaosId() %>" class="<%= chaosClass() %>"><div id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>><font face="Verdana" size="2"><%= c.name %></font></div></span></div>
                      <% } else if (idx % 4 === 1) { %>
                        <table border="0" cellpadding="0" cellspacing="0"><tr><td><div id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>><font face="Verdana" size="2"><%= c.name %></font></div></td></tr></table>
                      <% } else if (idx % 4 === 2) { %>
                        <span id="<%= chaosId() %>" class="<%= chaosClass() %>"><span id="<%= chaosId() %>" class="<%= chaosClass() %>"><span id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>><font face="Verdana" size="2"><%= c.name %></font></span></span></span>
                      <% } else { %>
                        <div id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>><ul style="margin:0;padding:0;list-style:none"><li id="<%= chaosId() %>" class="<%= chaosClass() %>"><font face="Verdana" size="2"><%= c.name %></font></li></ul></div>
                      <% } %>
                    </td>

                    <!-- ID CELL: sometimes in a nested table, sometimes plain -->
                    <td id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
                      <% if (idx % 3 === 0) { %>
                        <div id="<%= chaosId() %>" class="<%= chaosClass() %>"><div id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>><font face="Courier New" size="2"><%= c.id %></font></div></div>
                      <% } else if (idx % 3 === 1) { %>
                        <span id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>><code id="<%= chaosId() %>"><%= c.id %></code></span>
                      <% } else { %>
                        <font face="Courier New" size="2" id="<%= chaosId() %>"><%= c.id %></font>
                      <% } %>
                    </td>

                    <td id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
                      <div id="<%= chaosId() %>" class="<%= chaosClass() %>"><font face="Verdana" size="1"><%= c.position_applied %></font></div>
                    </td>

                    <td id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
                      <font face="Verdana" size="1"><%= c.city %></font>
                    </td>

                    <!-- STATUS CELL -->
                    <td id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
                      <div id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
                        <span id="<%= chaosId() %>" class="<%= chaosClass() %>" style="font-family:Verdana;font-size:10px;padding:1px 4px;background:<%= c.status === 'Rejected' ? '#ffcccc' : c.status === 'Offer Extended' ? '#ccffcc' : '#ffffcc' %>;border:1px solid #999;">
                          <%= c.status %>
                        </span>
                      </div>
                    </td>

                    <!-- ACTION CELL: download button structure differs every row -->
                    <td id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
                      <% if (idx % 5 === 0) { %>
                        <!-- Variant A: plain anchor deeply nested -->
                        <div id="<%= chaosId() %>" class="<%= chaosClass() %>"><span id="<%= chaosId() %>" class="<%= chaosClass() %>"><div id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
                          <a href="/download-cv/<%= c.id %>" class="dl-btn <%= chaosClass() %>" id="<%= chaosId() %>" <%= chaosDataAttrs() %>>Download CV</a>
                        </div></span></div>
                      <% } else if (idx % 5 === 1) { %>
                        <!-- Variant B: div role=button with onclick -->
                        <div id="<%= chaosId() %>" class="<%= chaosClass() %>"><table border="0"><tr><td>
                          <div role="button" tabindex="0" onclick="window.location.href='/download-cv/<%= c.id %>'" class="dl-btn <%= chaosClass() %>" id="<%= chaosId() %>" <%= chaosDataAttrs() %> aria-label="View profile details">Get CV</div>
                        </td></tr></table></div>
                      <% } else if (idx % 5 === 2) { %>
                        <!-- Variant C: button element with JS -->
                        <span id="<%= chaosId() %>" class="<%= chaosClass() %>"><span id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
                          <button type="button" onclick="location.assign('/download-cv/<%= c.id %>')" class="dl-btn <%= chaosClass() %>" id="<%= chaosId() %>" <%= chaosDataAttrs() %>>CV &darr;</button>
                        </span></span>
                      <% } else if (idx % 5 === 3) { %>
                        <!-- Variant D: image-like span with onclick, no button semantics -->
                        <div id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>><div id="<%= chaosId() %>" class="<%= chaosClass() %>"><div id="<%= chaosId() %>" class="<%= chaosClass() %>">
                          <span onclick="document.location='/download-cv/<%= c.id %>'" class="dl-btn <%= chaosClass() %>" id="<%= chaosId() %>" <%= chaosDataAttrs() %> style="cursor:pointer">&#128190; Resume</span>
                        </div></div></div>
                      <% } else { %>
                        <!-- Variant E: form with submit -->
                        <form action="/download-cv/<%= c.id %>" method="get" style="display:inline;margin:0" id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
                          <div id="<%= chaosId() %>" class="<%= chaosClass() %>"><input type="submit" value="Fetch File" class="dl-btn <%= chaosClass() %>" id="<%= chaosId() %>" <%= chaosDataAttrs() %>></div>
                        </form>
                      <% } %>
                      &nbsp;
                      <% if (idx % 2 === 0) { %>
                        <a href="/candidate/<%= c.id %>" class="vw-lnk <%= chaosClass() %>" id="<%= chaosId() %>" <%= chaosDataAttrs() %>>view</a>
                      <% } else { %>
                        <span onclick="window.location='/candidate/<%= c.id %>'" class="vw-lnk <%= chaosClass() %>" id="<%= chaosId() %>" <%= chaosDataAttrs() %>>open&nbsp;record</span>
                      <% } %>
                      <%- ghostElement('link') %>
                    </td>
                  </tr>
                  <% if (idx % 5 === 2) { %><%- ghostElement('row') %><% } %>
                <% }); %>
              </tbody>
            </table>
          </div>
        </span>
      </div>
    </div>

    <%- legacyCruft() %>

    <!-- Redundant duplicate list of same data in <ul> form, mostly hidden -->
    <div id="<%= chaosId() %>" class="<%= chaosClass() %>" style="height:0;overflow:hidden;" <%= chaosDataAttrs() %>>
      <ul id="<%= chaosId() %>" class="<%= chaosClass() %>" role="grid">
        <% candidates.forEach(function(c) { %>
          <li id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>><%= c.name %> - <%= c.id %></li>
        <% }); %>
      </ul>
    </div>

    <br>
    <div id="<%= chaosId() %>" class="<%= chaosClass() %>" style="text-align:center">
      <font face="Verdana" size="1" color="#888">Records 1-<%= candidates.length %> of <%= candidates.length %> &nbsp;|&nbsp; Page 1 of 1 &nbsp;|&nbsp; Query executed in 0.<%= rHex(3) %>s</font>
    </div>
  </div>

  <%- ghostElement('button') %>
  <%- easterEgg() %>
  <%- legacyCruft() %>
</body>
</html>
