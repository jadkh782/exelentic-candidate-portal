<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Account Settings :: EPS Portal</title>
  <link rel="stylesheet" href="/style.css">
  <style>body { font-family: 'Times New Roman', serif; background: #e8e0d4; margin: 0; font-size: 13px; }</style>
</head>
<body>
  <%- include('partials/topbar', { subtitle: 'Account Settings', active: 'settings' }) %>

  <div id="<%= chaosId() %>" class="<%= chaosClass() %>" style="background:#d4ccc0;padding:4px 20px;border-bottom:1px solid #999;" <%= chaosDataAttrs() %>>
    <font face="Verdana" size="1" color="#555">Home &gt; <b>Account</b></font>
  </div>

  <%- legacyCruft() %>

  <div style="padding:20px;">
    <div id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
      <font face="Verdana" size="3" color="#333"><b>Account Settings</b></font>
      <hr style="border:0;border-top:1px solid #c0b8ac;margin:12px 0">
    </div>

    <% if (saved) { %>
      <div id="<%= chaosId() %>" class="<%= chaosClass() %>" style="color:#2a5a0a;background:#d4edcc;border:1px solid #5c7a1a;padding:6px 10px;margin-bottom:12px;max-width:480px" <%= chaosDataAttrs() %>>
        <font face="Verdana" size="2"><b>&#10003;</b> Preferences saved (not persisted in demo mode).</font>
      </div>
    <% } %>

    <div id="<%= chaosId() %>" class="<%= chaosClass() %>" style="background:#fff;border:2px solid #999;padding:20px;max-width:480px;box-shadow:3px 3px 0 #888" <%= chaosDataAttrs() %>>
      <form action="/settings" method="POST" id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
        <%- legacyCruft() %>
        <table cellpadding="5" cellspacing="0" border="0" width="100%">
          <tr><td width="40%"><font face="Verdana" size="2">Display Name</font></td>
              <td><%- wrapChaos(`<input type="text" name="display_name" value="Administrator" id="${chaosId()}" class="${chaosClass()}" ${chaosDataAttrs()} style="width:220px;padding:4px;border:1px solid #aaa;font-family:Verdana;font-size:12px">`, 2, 4) %></td></tr>
          <tr bgcolor="#f5f2ec"><td><font face="Verdana" size="2">E-Mail</font></td>
              <td><%- wrapChaos(`<input type="text" name="email" value="admin@eps-legacy.internal" id="${chaosId()}" class="${chaosClass()}" ${chaosDataAttrs()} style="width:220px;padding:4px;border:1px solid #aaa;font-family:Verdana;font-size:12px">`, 2, 4) %></td></tr>
          <tr><td><font face="Verdana" size="2">Records per page</font></td>
              <td><%- wrapChaos(`<select name="page_size" id="${chaosId()}" class="${chaosClass()}" ${chaosDataAttrs()} style="padding:4px;border:1px solid #aaa;font-family:Verdana;font-size:12px"><option>10</option><option selected>25</option><option>50</option><option>All</option></select>`, 1, 3) %></td></tr>
          <tr bgcolor="#f5f2ec"><td><font face="Verdana" size="2">Theme</font></td>
              <td><%- wrapChaos(`<select name="theme" id="${chaosId()}" class="${chaosClass()}" ${chaosDataAttrs()} style="padding:4px;border:1px solid #aaa;font-family:Verdana;font-size:12px"><option selected>Classic Beige (2004)</option><option>High Contrast</option><option>Windows Grey</option></select>`, 1, 3) %></td></tr>
          <tr><td valign="top"><font face="Verdana" size="2">E-Mail Notifications</font></td>
              <td>
                <label style="font-family:Verdana;font-size:11px"><input type="checkbox" name="notify_new" id="<%= chaosId() %>" checked> New applications</label><br>
                <label style="font-family:Verdana;font-size:11px"><input type="checkbox" name="notify_offer" id="<%= chaosId() %>"> Offer status changes</label>
              </td></tr>
        </table>
        <br>
        <div id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
          <%- wrapChaos(`<button type="submit" id="${chaosId()}" class="${chaosClass()}" ${chaosDataAttrs()} style="background:#1a3a5c;color:#fff;border:1px solid #000;padding:6px 26px;font-family:Verdana;font-size:12px;cursor:pointer">Save Changes</button>`, 2, 4) %>
        </div>
      </form>
    </div>
  </div>

  <%- easterEgg() %>
  <%- legacyCruft() %>
</body>
</html>
