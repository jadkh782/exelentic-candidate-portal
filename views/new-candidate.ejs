<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Register New Application :: EPS Portal</title>
  <link rel="stylesheet" href="/style.css">
  <style>body { font-family: 'Times New Roman', serif; background: #e8e0d4; margin: 0; font-size: 13px; }</style>
</head>
<body>
  <%- include('partials/topbar', { subtitle: 'Register New Application', active: 'new' }) %>

  <div id="<%= chaosId() %>" class="<%= chaosClass() %>" style="background:#d4ccc0;padding:4px 20px;border-bottom:1px solid #999;" <%= chaosDataAttrs() %>>
    <font face="Verdana" size="1" color="#555">Home &gt; Candidates &gt; <b>New Application</b></font>
  </div>

  <%- legacyCruft() %>

  <div style="padding:20px;">
    <div id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
      <font face="Verdana" size="3" color="#333"><b>Register New Candidate</b></font>
      <hr style="border:0;border-top:1px solid #c0b8ac;margin:12px 0">
    </div>

    <% if (error) { %>
      <div id="<%= chaosId() %>" class="<%= chaosClass() %>" style="color:red;background:#ffe0e0;border:1px solid red;padding:6px 10px;margin-bottom:12px;max-width:500px" <%= chaosDataAttrs() %>>
        <font face="Verdana" size="2"><%= error %></font>
      </div>
    <% } %>

    <!-- honeypot decoy fields with the obvious names -->
    <div style="position:absolute;left:-9999px;opacity:0;">
      <input type="text" name="name" id="<%= chaosId() %>" tabindex="-1" autocomplete="off">
      <input type="text" name="email" id="<%= chaosId() %>" tabindex="-1" autocomplete="off">
    </div>

    <div id="<%= chaosId() %>" class="<%= chaosClass() %>" style="background:#fff;border:2px solid #999;padding:20px;max-width:520px;box-shadow:3px 3px 0 #888" <%= chaosDataAttrs() %>>
      <form action="/candidates/new" method="POST" id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
        <%- legacyCruft() %>
        <table cellpadding="5" cellspacing="0" border="0" width="100%" id="<%= chaosId() %>" class="<%= chaosClass() %>">

          <tr id="<%= chaosId() %>" class="<%= chaosClass() %>">
            <td width="35%"><div id="<%= chaosId() %>"><span id="<%= chaosId() %>" class="<%= chaosClass() %>"><font face="Verdana" size="2">Full Name <font color="red">*</font></font></span></div></td>
            <td>
              <%- ghostElement('input') %>
              <%- wrapChaos(`<input type="text" name="name" value="${(values.name||'').replace(/"/g,'&quot;')}" id="${chaosId()}" class="${chaosClass()}" ${chaosDataAttrs()} style="width:250px;padding:4px;border:1px solid #aaa;font-family:Verdana;font-size:12px" autocomplete="off">`, 3, 5) %>
            </td>
          </tr>

          <tr id="<%= chaosId() %>" class="<%= chaosClass() %>" bgcolor="#f5f2ec">
            <td><span id="<%= chaosId() %>" class="<%= chaosClass() %>"><font face="Verdana" size="2">E-Mail Address</font></span></td>
            <td>
              <%- ghostElement('input') %>
              <%- wrapChaos(`<input type="text" name="email" value="${(values.email||'').replace(/"/g,'&quot;')}" id="${chaosId()}" class="${chaosClass()}" ${chaosDataAttrs()} style="width:250px;padding:4px;border:1px solid #aaa;font-family:Verdana;font-size:12px" autocomplete="off">`, 2, 5) %>
            </td>
          </tr>

          <tr id="<%= chaosId() %>" class="<%= chaosClass() %>">
            <td><div id="<%= chaosId() %>"><div id="<%= chaosId() %>"><font face="Verdana" size="2">Telephone</font></div></div></td>
            <td><%- wrapChaos(`<input type="text" name="phone" value="${(values.phone||'').replace(/"/g,'&quot;')}" id="${chaosId()}" class="${chaosClass()}" ${chaosDataAttrs()} style="width:250px;padding:4px;border:1px solid #aaa;font-family:Verdana;font-size:12px" autocomplete="off">`, 2, 4) %></td>
          </tr>

          <tr id="<%= chaosId() %>" class="<%= chaosClass() %>" bgcolor="#f5f2ec">
            <td><span id="<%= chaosId() %>" class="<%= chaosClass() %>"><font face="Verdana" size="2">City</font></span></td>
            <td><%- wrapChaos(`<input type="text" name="city" value="${(values.city||'').replace(/"/g,'&quot;')}" id="${chaosId()}" class="${chaosClass()}" ${chaosDataAttrs()} style="width:250px;padding:4px;border:1px solid #aaa;font-family:Verdana;font-size:12px" autocomplete="off">`, 1, 4) %></td>
          </tr>

          <tr id="<%= chaosId() %>" class="<%= chaosClass() %>">
            <td><font face="Verdana" size="2">Talent Category</font></td>
            <td>
              <%- ghostElement('input') %>
              <%- wrapChaos(`<select name="category" id="${chaosId()}" class="${chaosClass()}" ${chaosDataAttrs()} style="padding:4px;border:1px solid #aaa;font-family:Verdana;font-size:12px;min-width:258px">
                ${categories.map(x=>`<option value="${x.key}"${values.category===x.key?' selected':''}>${x.label}</option>`).join('')}
              </select>`, 2, 4) %>
            </td>
          </tr>

          <tr id="<%= chaosId() %>" class="<%= chaosClass() %>" bgcolor="#f5f2ec">
            <td><font face="Verdana" size="2">Position Applied For</font></td>
            <td>
              <%- wrapChaos(`<input type="text" name="position_applied" value="${(values.position_applied||'').replace(/"/g,'&quot;')}" id="${chaosId()}" class="${chaosClass()}" ${chaosDataAttrs()} style="width:250px;padding:4px;border:1px solid #aaa;font-family:Verdana;font-size:12px" autocomplete="off">`, 2, 4) %>
            </td>
          </tr>

          <tr id="<%= chaosId() %>" class="<%= chaosClass() %>" bgcolor="#f5f2ec">
            <td><span id="<%= chaosId() %>" class="<%= chaosClass() %>"><font face="Verdana" size="2">Years of Experience</font></span></td>
            <td><%- wrapChaos(`<input type="text" name="experience_years" value="${(values.experience_years||'').toString().replace(/"/g,'&quot;')}" id="${chaosId()}" class="${chaosClass()}" ${chaosDataAttrs()} style="width:80px;padding:4px;border:1px solid #aaa;font-family:Verdana;font-size:12px" autocomplete="off">`, 1, 3) %></td>
          </tr>
        </table>

        <%- legacyCruft() %>
        <br>
        <div id="<%= chaosId() %>" class="<%= chaosClass() %>" <%= chaosDataAttrs() %>>
          <%- wrapChaos(`<input type="submit" value="Create Record" id="${chaosId()}" class="${chaosClass()}" ${chaosDataAttrs()} style="background:#5c7a1a;color:#fff;border:1px solid #000;padding:6px 26px;font-family:Verdana;font-size:12px;cursor:pointer">`, 2, 4) %>
          &nbsp;&nbsp;<a href="/dashboard" style="font-family:Verdana;font-size:11px;color:#888">Cancel</a>
        </div>
      </form>
    </div>

    <br>
    <font face="Verdana" size="1" color="#999">A CV document will be auto-generated for the new record on save.</font>
  </div>

  <%- easterEgg() %>
  <%- legacyCruft() %>
</body>
</html>
